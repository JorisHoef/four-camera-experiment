# ===================================

# Android artifacts
.gradle/
*.apk
*.aab
*.apks
*.dex
*.class
*.keystore
*.so

# Gradle wrapper
**/gradle-wrapper.jar
**/gradle-wrapper.properties
**/local.properties

# iOS / Xcode
build/
*.xcworkspace/
*.xcodeproj/
*.xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3

# Magic Leap / ML Hub
.mlconfig/
.mlrun/
*.mlog
*.mpk
# (Avoid global *.mp4 ignores; scope to a folder if needed)
# MLExports/**/*.mp4

# IL2CPP / Native Compilation
Il2CppOutputProject/
*.exe
*.dll
*.dylib

# ...except those in the Assets/Plugins folder.
!Assets/Packages/**/*.dll
!Assets/Plugins/**/*.dll
!Assets/Packages/**/*.so
!Assets/Plugins/**/*.so
!Assets/Packages/**/*.jar
!Assets/Plugins/**/*.jar
!Assets/Packages/**/*.aar
!Assets/Plugins/**/*.aar

